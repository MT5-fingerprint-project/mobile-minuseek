{
  "expo": {
    "name": "Minuseek",
    "slug": "minuseek",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobileminuseek",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.minuseek.mobile"
    },
    "android": {
      "package": "com.minuseek.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#010516",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#010516",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 120
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "L'application a besoin de l'accès à la caméra pour prendre des photos."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "L'application a besoin d'enregistrer les photos dans votre galerie."
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "L'application a besoin de l'accès à la caméra pour photographier les traces d'une affaire.",
          "enableMicrophonePermission": false,
          "enableFrameProcessors": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "92477328-813b-4d84-89cb-72224c0b47e4"
      }
    },
    "owner": "adrienien"
  }
}
